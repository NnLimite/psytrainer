# Все параметры: см. app/config.py. Префикс PSY_.
PSY_ENV=dev
# Обязательно смените секреты в проде (не короче 32 символов)
PSY_SECRET_KEY=change-me-change-me-change-me-change-me
PSY_PAYMENT_WEBHOOK_SECRET=change-me-too
# http без TLS: в dev cookie не может быть Secure
PSY_COOKIE_SECURE=false
PSY_PUBLIC_URL=http://localhost:8000
PSY_FRONTEND_URL=http://localhost:5173
PSY_CORS_ORIGINS=["http://localhost:5173"]

# LLM: точный тег вашей модели Qwen 27B-30B (ollama list). judge_model необязателен: отдельная модель для оценки.
PSY_OLLAMA_URL=http://host.docker.internal:11434
PSY_OLLAMA_MODEL=qwen3:30b
# PSY_JUDGE_MODEL=
PSY_OLLAMA_NUM_CTX=8192
# false: разметка реплик студента только эвристикой (быстрее, грубее)
PSY_USE_LLM_CLASSIFIER=true

# Почта (если не задано, письма пишутся в лог)
# PSY_SMTP_HOST=
# PSY_SMTP_PORT=587
# PSY_SMTP_USER=
# PSY_SMTP_PASSWORD=
# SSO: {"uni": {"client_id": "...", "client_secret": "...", "authorization_endpoint": "...", "token_endpoint": "...", "userinfo_endpoint": "..."}}
# PSY_SSO_PROVIDERS=
